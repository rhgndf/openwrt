From: Ho Jie Feng <hjf3108@gmail.com>
Subject: [PATCH] pinctrl: bcm: add BCM47622 pinctrl driver

BCM47622 (and its BCM6755 variant) muxes pins through the same GPIO block
"test port" interface as BCM4908: pin number and function are written to
TEST_PORT_BLOCK_DATA_LSB and a LOAD_MUX_REG command is issued. It has 108
pins and a different function table though, so add a separate driver for
it, based on pinctrl-bcm4908 and the Broadcom SDK pinctrl data.

The driver itself lives in target/linux/bcmbca/files. It implements
gpio_request_enable so pins get switched to the GPIO function (4)
whenever a GPIO mapped with gpio-ranges is requested.

It also supports the generic "drive-strength" (2..16 mA) and
"power-source" (1800/2500/3300 mV) pin configs, loaded with the test port
LOAD_PAD_CTRL command. Setting the power source of RGMII pins (56-67) also
programs the xMII voltage mode bits of the GPIO PAD_CTRL register, like
the Broadcom SDK does for external switches connected over RGMII.

Signed-off-by: Ho Jie Feng <hjf3108@gmail.com>
---
 drivers/pinctrl/bcm/Kconfig  | 15 +++++++++++++++
 drivers/pinctrl/bcm/Makefile |  1 +
 2 files changed, 16 insertions(+)

--- a/drivers/pinctrl/bcm/Kconfig
+++ b/drivers/pinctrl/bcm/Kconfig
@@ -29,6 +29,21 @@
 	help
 	   Say Y here to enable the Broadcom BCM2835 GPIO driver.
 
+config PINCTRL_BCM47622
+	tristate "Broadcom BCM47622 pinmux driver"
+	depends on OF && (ARCH_BCMBCA || COMPILE_TEST)
+	select PINMUX
+	select PINCONF
+	select GENERIC_PINCONF
+	select GENERIC_PINCTRL_GROUPS
+	select GENERIC_PINMUX_FUNCTIONS
+	default ARCH_BCMBCA
+	help
+	  Driver for BCM47622 family SoCs (BCM47622, BCM6755) with integrated
+	  pin controller.
+
+	  If compiled as module it will be called pinctrl-bcm47622.
+
 config PINCTRL_BCM4908
 	tristate "Broadcom BCM4908 pinmux driver"
 	depends on OF && (ARCH_BCMBCA || COMPILE_TEST)
--- a/drivers/pinctrl/bcm/Makefile
+++ b/drivers/pinctrl/bcm/Makefile
@@ -3,6 +3,7 @@
 
 obj-$(CONFIG_PINCTRL_BCM281XX)		+= pinctrl-bcm281xx.o
 obj-$(CONFIG_PINCTRL_BCM2835)		+= pinctrl-bcm2835.o
+obj-$(CONFIG_PINCTRL_BCM47622)		+= pinctrl-bcm47622.o
 obj-$(CONFIG_PINCTRL_BCM4908)		+= pinctrl-bcm4908.o
 obj-$(CONFIG_PINCTRL_BCM63XX)		+= pinctrl-bcm63xx.o
 obj-$(CONFIG_PINCTRL_BCM6318)		+= pinctrl-bcm6318.o
