+
+static const struct bcmbca_pmb_power_data bcm47622_domains[] = {
+	[BCM6755_PD_CRYPTO] = {
+		.name = "crypto",
+		.blocks = bcm47622_crypto,
+		.num_blocks = ARRAY_SIZE(bcm47622_crypto),
+	},
+};
+
+static const struct bcmbca_pmb_power_variant bcm47622_power_variant = {
+	.domains = bcm47622_domains,
+	.num_domains = ARRAY_SIZE(bcm47622_domains),
+};
