@@ -205,6 +235,7 @@ static int bcmbca_pmb_power_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct regmap *regmap = dev_get_regmap(dev->parent, NULL);
+	const struct bcmbca_pmb_power_variant *variant;
 	struct bcmbca_pmb_power_domain *domains;
 	struct genpd_onecell_data *onecell;
 	unsigned int i;
@@ -213,11 +244,14 @@ static int bcmbca_pmb_power_probe(struct platform_device *pdev)
 
 	if (!regmap)
 		return -ENODEV;
+	variant = device_get_match_data(dev);
+	if (!variant)
+		return -ENODEV;
 
 	onecell = devm_kzalloc(dev, sizeof(*onecell), GFP_KERNEL);
 	if (!onecell)
 		return -ENOMEM;
-	onecell->num_domains = ARRAY_SIZE(bcm6846_domains);
+	onecell->num_domains = variant->num_domains;
