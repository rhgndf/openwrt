From: Ho Jie Feng <hjf3108@gmail.com>
Subject: [PATCH] bcmbca-pmb: add BCM47622 support

BCM47622 (BCM6755) has the same PMC3 Power Management Bus as BCM6846,
with its blocks at different bus and device numbers. Move the per-SoC
tables of the PMB transport, power-domain, clock, reset and PVTMON
drivers into match data and add BCM47622 tables:

- PVTMON at bus 0, device 2, with the BCM6846 register layout,
  conversion formulas and voltage dividers
- PVTMON acquisition clock and reset, both in PVTMON register 17
- SPU crypto power domain at bus 0, device 1, one zone

The vendor tables are in bcmdrivers/opensource/misc/pmc/impl1/47622/
pmc_addr.h and BPCM.h, and the conversion in pmc_drv.c
pmc_convert_pvtmon() and pmc_sysfs.c (src-rt-5.04axhnd.675x).

Signed-off-by: Ho Jie Feng <hjf3108@gmail.com>
---
 .../bindings/mfd/brcm,bcm6846-pmc.yaml        | 35 ++++++---
 drivers/clk/bcm/clk-bcmbca-pmb.c              | 35 +++++++--
 drivers/hwmon/bcm_pmb_pvtmon.c                | 71 ++++++++++++++-----
 drivers/mfd/bcmbca_pmc3_pmb.c                 | 46 +++++++++++-
 drivers/pmdomain/bcm/bcmbca-pmb.c             | 43 +++++++++--
 drivers/reset/reset-bcmbca-pmb.c              | 24 +++++++
 include/dt-bindings/clock/brcm,bcm6755-pmb.h  |  8 +++
 include/dt-bindings/power/brcm,bcm6755-pmb.h  |  8 +++
 include/dt-bindings/reset/brcm,bcm6755-pmb.h  |  8 +++
 9 files changed, 240 insertions(+), 38 deletions(-)

diff --git a/Documentation/devicetree/bindings/mfd/brcm,bcm6846-pmc.yaml b/Documentation/devicetree/bindings/mfd/brcm,bcm6846-pmc.yaml
index eb01797..af2cc9d 100644
--- a/Documentation/devicetree/bindings/mfd/brcm,bcm6846-pmc.yaml
+++ b/Documentation/devicetree/bindings/mfd/brcm,bcm6846-pmc.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/mfd/brcm,bcm6846-pmc.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Broadcom BCM6846 Power Management Controller
+title: Broadcom BCM6846 and BCM6755 Power Management Controller
 
 maintainers:
   - Linus Walleij <linusw@kernel.org>
@@ -18,7 +18,9 @@ description:
 properties:
   compatible:
     items:
-      - const: brcm,bcm6846-pmc
+      - enum:
+          - brcm,bcm6755-pmc
+          - brcm,bcm6846-pmc
       - const: simple-mfd
 
   ranges:
@@ -46,7 +48,9 @@ patternProperties:
 
     properties:
       compatible:
-        const: brcm,bcm6846-pmb
+        enum:
+          - brcm,bcm6755-pmb
+          - brcm,bcm6846-pmb
 
       reg:
         maxItems: 1
@@ -74,13 +78,18 @@ patternProperties:
           resources required for system operation. CPU and PLL blocks use different
           register layouts and are outside the scope of this provider.
 
+          BCM6755 domain IDs are defined in dt-bindings/power/brcm,bcm6755-pmb.h:
+            BCM6755_PD_CRYPTO: SPU crypto accelerator (bus 0, device 1, one zone)
+
         properties:
           compatible:
-            const: brcm,bcm6846-pmb-power
+            enum:
+              - brcm,bcm6755-pmb-power
+              - brcm,bcm6846-pmb-power
 
           '#power-domain-cells':
             const: 1
-            description: Power domain ID from dt-bindings/power/brcm,bcm6846-pmb.h
+            description: Power domain ID from dt-bindings/power/brcm,<soc>-pmb.h
 
         required:
           - compatible
@@ -97,10 +106,14 @@ patternProperties:
           are defined in dt-bindings/clock/brcm,bcm6846-pmb.h.
           The PLLs and crystal output use a 50 MHz reference clock.
           Zone clocks require their associated blocks to be powered.
+          On BCM6755, only the PVTMON acquisition clock is provided, with
+          its index defined in dt-bindings/clock/brcm,bcm6755-pmb.h.
 
         properties:
           compatible:
-            const: brcm,bcm6846-pmb-clock
+            enum:
+              - brcm,bcm6755-pmb-clock
+              - brcm,bcm6846-pmb-clock
 
           clocks:
             maxItems: 1
@@ -130,11 +143,13 @@ patternProperties:
 
         properties:
           compatible:
-            const: brcm,bcm6846-pmb-reset
+            enum:
+              - brcm,bcm6755-pmb-reset
+              - brcm,bcm6846-pmb-reset
 
           '#reset-cells':
             const: 1
-            description: Reset group ID from dt-bindings/reset/brcm,bcm6846-pmb.h
+            description: Reset group ID from dt-bindings/reset/brcm,<soc>-pmb.h
 
         required:
           - compatible
@@ -155,7 +170,9 @@ patternProperties:
 
         properties:
           compatible:
-            const: brcm,bcm6846-pmb-pvtmon
+            enum:
+              - brcm,bcm6755-pmb-pvtmon
+              - brcm,bcm6846-pmb-pvtmon
 
           clocks:
             maxItems: 1
diff --git a/drivers/clk/bcm/clk-bcmbca-pmb.c b/drivers/clk/bcm/clk-bcmbca-pmb.c
index fcee63e..cfc6dc7 100644
--- a/drivers/clk/bcm/clk-bcmbca-pmb.c
+++ b/drivers/clk/bcm/clk-bcmbca-pmb.c
@@ -13,8 +13,10 @@
 #include <linux/mfd/bcmbca-pmb.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/regmap.h>
 
+#include <dt-bindings/clock/brcm,bcm6755-pmb.h>
 #include <dt-bindings/clock/brcm,bcm6846-pmb.h>
 
 /* PMB register offsets are in 32-bit words. */
@@ -64,6 +66,11 @@ struct bcmbca_pmb_clock_desc {
 	const struct bcmbca_pmb_pll_layout *pll;
 };
 
+struct bcmbca_pmb_clock_data {
+	const struct bcmbca_pmb_clock_desc *descs;
+	unsigned int num_descs;
+};
+
 struct bcmbca_pmb_clock {
 	struct clk_hw hw;
 	struct device *dev;
@@ -299,10 +306,25 @@ static const struct bcmbca_pmb_clock_desc bcm6846_clocks[] = {
 	PMB_GATE(BCM6846_CLK_BIU, "biu", PMB_ZONE, 1, 39, 16),
 };
 
+static const struct bcmbca_pmb_clock_data bcm6846_clock_data = {
+	.descs = bcm6846_clocks,
+	.num_descs = ARRAY_SIZE(bcm6846_clocks),
+};
+
+static const struct bcmbca_pmb_clock_desc bcm47622_clocks[] = {
+	PMB_GATE(BCM6755_CLK_PVTMON, "pvtmon", PMB_PVTMON, 0, 2, PVTMON_CONFIG),
+};
+
+static const struct bcmbca_pmb_clock_data bcm47622_clock_data = {
+	.descs = bcm47622_clocks,
+	.num_descs = ARRAY_SIZE(bcm47622_clocks),
+};
+
 static int bcmbca_pmb_clock_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct regmap *regmap = dev_get_regmap(dev->parent, NULL);
+	const struct bcmbca_pmb_clock_data *variant;
 	struct clk_hw_onecell_data *data;
 	struct bcmbca_pmb_clock *clocks;
 	unsigned int i;
@@ -310,18 +332,21 @@ static int bcmbca_pmb_clock_probe(struct platform_device *pdev)
 
 	if (!regmap)
 		return -ENODEV;
+	variant = device_get_match_data(dev);
+	if (!variant)
+		return -ENODEV;
 
-	data = devm_kzalloc(dev, struct_size(data, hws, ARRAY_SIZE(bcm6846_clocks)),
+	data = devm_kzalloc(dev, struct_size(data, hws, variant->num_descs),
 			    GFP_KERNEL);
 	if (!data)
 		return -ENOMEM;
-	data->num = ARRAY_SIZE(bcm6846_clocks);
+	data->num = variant->num_descs;
 	clocks = devm_kcalloc(dev, data->num, sizeof(*clocks), GFP_KERNEL);
 	if (!clocks)
 		return -ENOMEM;
 
 	for (i = 0; i < data->num; i++) {
-		const struct bcmbca_pmb_clock_desc *desc = &bcm6846_clocks[i];
+		const struct bcmbca_pmb_clock_desc *desc = &variant->descs[i];
 		struct clk_parent_data parent = {};
 		struct clk_init_data init = {
 			.ops = &bcmbca_pmb_clock_ops,
@@ -330,6 +355,7 @@ static int bcmbca_pmb_clock_probe(struct platform_device *pdev)
 		init.name = devm_kasprintf(dev, GFP_KERNEL, "%s-%s", dev_name(dev), desc->name);
 		if (!init.name)
 			return -ENOMEM;
+		/* Only BCM6846 has a Runner clock. */
 		if (desc->type == PMB_RUNNER) {
 			struct clk_hw *parent_hw = data->hws[BCM6846_CLK_RDPPLL_CH1];
 
@@ -362,7 +388,8 @@ static int bcmbca_pmb_clock_probe(struct platform_device *pdev)
 }
 
 static const struct of_device_id bcmbca_pmb_clock_match[] = {
-	{ .compatible = "brcm,bcm6846-pmb-clock" },
+	{ .compatible = "brcm,bcm6755-pmb-clock", .data = &bcm47622_clock_data },
+	{ .compatible = "brcm,bcm6846-pmb-clock", .data = &bcm6846_clock_data },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, bcmbca_pmb_clock_match);
diff --git a/drivers/hwmon/bcm_pmb_pvtmon.c b/drivers/hwmon/bcm_pmb_pvtmon.c
index 4fde15f..4ba6dc5 100644
--- a/drivers/hwmon/bcm_pmb_pvtmon.c
+++ b/drivers/hwmon/bcm_pmb_pvtmon.c
@@ -10,12 +10,10 @@
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
 
-#define PVTMON_BUS		1
-#define PVTMON_DEVICE		6
-
 /* PMB register offsets are in 32-bit words. */
 #define PVTMON_CONFIG		17
 #define PVTMON_RESET_N		BIT(0)
@@ -32,7 +30,7 @@
 #define PVTMON_SAMPLES		GENMASK(26, 24)
 #define PVTMON_CHANNEL_ENABLE	BIT(31)
 
-/* BCM6846 voltage channel labels and input-divider ratios. */
+/* Voltage channel labels and input-divider ratios, shared by BCM6846 and BCM47622. */
 static const struct {
 	const char *label;
 	unsigned int divisor;
@@ -46,10 +44,28 @@ static const struct {
 	{ "Vtest", 10 },
 };
 
-static int bcm_pmb_pvtmon_init(struct regmap *regmap,
+struct bcm_pmb_pvtmon_data {
+	const char *name;
+	u8 bus;
+	u8 device;
+};
+
+struct bcm_pmb_pvtmon {
+	struct regmap *regmap;
+	const struct bcm_pmb_pvtmon_data *data;
+};
+
+static unsigned int bcm_pmb_pvtmon_reg(const struct bcm_pmb_pvtmon *pvt,
+				       unsigned int offset)
+{
+	return BCMBCA_PMB_REG(pvt->data->bus, pvt->data->device, offset);
+}
+
+static int bcm_pmb_pvtmon_init(struct bcm_pmb_pvtmon *pvt,
 			       struct reset_control *reset)
 {
-	unsigned int reg = BCMBCA_PMB_REG(PVTMON_BUS, PVTMON_DEVICE, PVTMON_CONFIG);
+	struct regmap *regmap = pvt->regmap;
+	unsigned int reg = bcm_pmb_pvtmon_reg(pvt, PVTMON_CONFIG);
 	u32 config, acq, channel;
 	unsigned int i;
 	int ret;
@@ -68,13 +84,12 @@ static int bcm_pmb_pvtmon_init(struct regmap *regmap,
 			return ret;
 	}
 
-	ret = regmap_read(regmap, BCMBCA_PMB_REG(PVTMON_BUS, PVTMON_DEVICE,
-						 PVTMON_ACQ_CONFIG), &acq);
+	ret = regmap_read(regmap, bcm_pmb_pvtmon_reg(pvt, PVTMON_ACQ_CONFIG), &acq);
 	if (ret)
 		return ret;
 
 	for (i = 0; i < PVTMON_NUM_CHANNELS; i++) {
-		reg = BCMBCA_PMB_REG(PVTMON_BUS, PVTMON_DEVICE, PVTMON_CHANNEL_BASE + i);
+		reg = bcm_pmb_pvtmon_reg(pvt, PVTMON_CHANNEL_BASE + i);
 		ret = regmap_read(regmap, reg, &channel);
 		if (ret)
 			return ret;
@@ -91,8 +106,7 @@ static int bcm_pmb_pvtmon_init(struct regmap *regmap,
 
 	if (!(acq & PVTMON_ACCUM_ENABLE))
 		return regmap_update_bits(regmap,
-					  BCMBCA_PMB_REG(PVTMON_BUS, PVTMON_DEVICE,
-							 PVTMON_ACQ_CONFIG),
+					  bcm_pmb_pvtmon_reg(pvt, PVTMON_ACQ_CONFIG),
 					  PVTMON_SKIP_LENGTH | PVTMON_ACCUM_ENABLE,
 					  PVTMON_ACCUM_ENABLE | FIELD_PREP(PVTMON_SKIP_LENGTH, 8));
 
@@ -102,7 +116,7 @@ static int bcm_pmb_pvtmon_init(struct regmap *regmap,
 static int bcm_pmb_pvtmon_read(struct device *dev, enum hwmon_sensor_types type,
 			       u32 attr, int channel, long *val)
 {
-	struct regmap *map = dev_get_drvdata(dev);
+	struct bcm_pmb_pvtmon *pvt = dev_get_drvdata(dev);
 	unsigned int index;
 	u32 value;
 	int ret;
@@ -123,9 +137,8 @@ static int bcm_pmb_pvtmon_read(struct device *dev, enum hwmon_sensor_types type,
 	}
 
 	/* Release the PMB between samples so other clients can make progress. */
-	ret = regmap_read_poll_timeout(map,
-				       BCMBCA_PMB_REG(PVTMON_BUS, PVTMON_DEVICE,
-						      PVTMON_CHANNEL_BASE + index),
+	ret = regmap_read_poll_timeout(pvt->regmap,
+				       bcm_pmb_pvtmon_reg(pvt, PVTMON_CHANNEL_BASE + index),
 				       value, value & PVTMON_VALID, 1000, 100000);
 	if (ret)
 		return ret;
@@ -183,6 +196,7 @@ static int bcm_pmb_pvtmon_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct regmap *regmap = dev_get_regmap(dev->parent, NULL);
+	struct bcm_pmb_pvtmon *pvt;
 	struct device *hwmon;
 	struct reset_control *reset;
 	struct clk *clk;
@@ -191,6 +205,14 @@ static int bcm_pmb_pvtmon_probe(struct platform_device *pdev)
 	if (!regmap)
 		return -ENODEV;
 
+	pvt = devm_kzalloc(dev, sizeof(*pvt), GFP_KERNEL);
+	if (!pvt)
+		return -ENOMEM;
+	pvt->regmap = regmap;
+	pvt->data = device_get_match_data(dev);
+	if (!pvt->data)
+		return -ENODEV;
+
 	reset = devm_reset_control_get_exclusive(dev, NULL);
 	if (IS_ERR(reset))
 		return dev_err_probe(dev, PTR_ERR(reset), "failed to get PVTMON reset\n");
@@ -199,11 +221,11 @@ static int bcm_pmb_pvtmon_probe(struct platform_device *pdev)
 	if (IS_ERR(clk))
 		return dev_err_probe(dev, PTR_ERR(clk), "failed to enable PVTMON clock\n");
 
-	ret = bcm_pmb_pvtmon_init(regmap, reset);
+	ret = bcm_pmb_pvtmon_init(pvt, reset);
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to initialize PVTMON\n");
 
-	hwmon = devm_hwmon_device_register_with_info(dev, "bcm6846_pvtmon", regmap,
+	hwmon = devm_hwmon_device_register_with_info(dev, pvt->data->name, pvt,
 						     &bcm_pmb_pvtmon_chip_info, NULL);
 	if (IS_ERR(hwmon))
 		return dev_err_probe(dev, PTR_ERR(hwmon), "failed to register hwmon device\n");
@@ -212,8 +234,21 @@ static int bcm_pmb_pvtmon_probe(struct platform_device *pdev)
 	return 0;
 }
 
+static const struct bcm_pmb_pvtmon_data bcm47622_pvtmon_data = {
+	.name = "bcm47622_pvtmon",
+	.bus = 0,
+	.device = 2,
+};
+
+static const struct bcm_pmb_pvtmon_data bcm6846_pvtmon_data = {
+	.name = "bcm6846_pvtmon",
+	.bus = 1,
+	.device = 6,
+};
+
 static const struct of_device_id bcm_pmb_pvtmon_of_match[] = {
-	{ .compatible = "brcm,bcm6846-pmb-pvtmon" },
+	{ .compatible = "brcm,bcm6755-pmb-pvtmon", .data = &bcm47622_pvtmon_data },
+	{ .compatible = "brcm,bcm6846-pmb-pvtmon", .data = &bcm6846_pvtmon_data },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, bcm_pmb_pvtmon_of_match);
diff --git a/drivers/mfd/bcmbca_pmc3_pmb.c b/drivers/mfd/bcmbca_pmc3_pmb.c
index d268988..17177df 100644
--- a/drivers/mfd/bcmbca_pmc3_pmb.c
+++ b/drivers/mfd/bcmbca_pmc3_pmb.c
@@ -18,6 +18,7 @@
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/workqueue.h>
 
@@ -232,6 +233,35 @@ static void bcmbca_pmb_stop(void *data)
 	}
 }
 
+struct bcmbca_pmb_data {
+	const struct mfd_cell *cells;
+	unsigned int num_cells;
+};
+
+static const struct mfd_cell bcm47622_pmb_cells[] = {
+	{
+		.name = "bcm47622-pmb-power",
+		.of_compatible = "brcm,bcm6755-pmb-power",
+	},
+	{
+		.name = "bcm47622-pmb-clock",
+		.of_compatible = "brcm,bcm6755-pmb-clock",
+	},
+	{
+		.name = "bcm47622-pmb-reset",
+		.of_compatible = "brcm,bcm6755-pmb-reset",
+	},
+	{
+		.name = "bcm47622-pmb-pvtmon",
+		.of_compatible = "brcm,bcm6755-pmb-pvtmon",
+	},
+};
+
+static const struct bcmbca_pmb_data bcm47622_pmb_data = {
+	.cells = bcm47622_pmb_cells,
+	.num_cells = ARRAY_SIZE(bcm47622_pmb_cells),
+};
+
 static const struct mfd_cell bcm6846_pmb_cells[] = {
 	{
 		.name = "bcm6846-pmb-power",
@@ -251,14 +281,23 @@ static const struct mfd_cell bcm6846_pmb_cells[] = {
 	},
 };
 
+static const struct bcmbca_pmb_data bcm6846_pmb_data = {
+	.cells = bcm6846_pmb_cells,
+	.num_cells = ARRAY_SIZE(bcm6846_pmb_cells),
+};
+
 static int bcmbca_pmb_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
+	const struct bcmbca_pmb_data *data;
 	struct bcmbca_pmb *pmb;
 	struct regmap *regmap;
 	struct resource *res;
 	int ret;
 
+	data = device_get_match_data(dev);
+	if (!data)
+		return -ENODEV;
 	pmb = devm_kzalloc(dev, sizeof(*pmb), GFP_KERNEL);
 	if (!pmb)
 		return -ENOMEM;
@@ -280,8 +319,8 @@ static int bcmbca_pmb_probe(struct platform_device *pdev)
 	regmap = bcmbca_pmb_regmap_init(pmb);
 	if (IS_ERR(regmap))
 		return dev_err_probe(dev, PTR_ERR(regmap), "failed to register PMB regmap\n");
-	ret = devm_mfd_add_devices(dev, PLATFORM_DEVID_AUTO, bcm6846_pmb_cells,
-				   ARRAY_SIZE(bcm6846_pmb_cells), NULL, 0, NULL);
+	ret = devm_mfd_add_devices(dev, PLATFORM_DEVID_AUTO, data->cells,
+				   data->num_cells, NULL, 0, NULL);
 	if (ret)
 		return dev_err_probe(dev, ret,
 				     "failed to register PMB functions\n");
@@ -290,7 +329,8 @@ static int bcmbca_pmb_probe(struct platform_device *pdev)
 }
 
 static const struct of_device_id bcmbca_pmb_match[] = {
-	{ .compatible = "brcm,bcm6846-pmb" },
+	{ .compatible = "brcm,bcm6755-pmb", .data = &bcm47622_pmb_data },
+	{ .compatible = "brcm,bcm6846-pmb", .data = &bcm6846_pmb_data },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, bcmbca_pmb_match);
diff --git a/drivers/pmdomain/bcm/bcmbca-pmb.c b/drivers/pmdomain/bcm/bcmbca-pmb.c
index 9a631b7..11e2482 100644
--- a/drivers/pmdomain/bcm/bcmbca-pmb.c
+++ b/drivers/pmdomain/bcm/bcmbca-pmb.c
@@ -6,11 +6,16 @@
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
+#include <linux/property.h>
 #include <linux/regmap.h>
 
+#include <dt-bindings/power/brcm,bcm6755-pmb.h>
 #include <dt-bindings/power/brcm,bcm6846-pmb.h>
 
-/* BCM6846 BPCM zone control, in PMB words, with eight words per zone. */
+/*
+ * BCM6846 BPCM zone control, in PMB words, with eight words per zone.
+ * BCM47622 uses the same layout.
+ */
 #define BCM6846_ZONE_CONTROL(zone)	(32 + (zone) * 8)
 #define BCM6846_ZONE_DPG_EN		BIT(8)
 #define BCM6846_ZONE_POWER_DOWN		BIT(9)
@@ -33,6 +38,11 @@ struct bcmbca_pmb_power_data {
 	unsigned int flags;
 };
 
+struct bcmbca_pmb_power_variant {
+	const struct bcmbca_pmb_power_data *domains;
+	unsigned int num_domains;
+};
+
 struct bcmbca_pmb_power_domain {
 	struct generic_pm_domain genpd;
 	struct device *dev;
@@ -86,6 +96,26 @@ static const struct bcmbca_pmb_power_data bcm6846_domains[] = {
 	},
 };
 
+static const struct bcmbca_pmb_power_variant bcm6846_power_variant = {
+	.domains = bcm6846_domains,
+	.num_domains = ARRAY_SIZE(bcm6846_domains),
+};
+
