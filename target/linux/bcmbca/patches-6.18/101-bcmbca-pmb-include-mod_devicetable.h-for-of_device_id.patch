From: Ho Jie Feng <hjf3108@gmail.com>
Subject: [PATCH] bcmbca-pmb: include mod_devicetable.h for of_device_id

The PMB transport, reset and PVTMON drivers use struct of_device_id
without including <linux/mod_devicetable.h>. On Linux 6.18 none of
their other headers pull it in, so they fail to build.

Signed-off-by: Ho Jie Feng <hjf3108@gmail.com>
---
 drivers/hwmon/bcm_pmb_pvtmon.c   | 1 +
 drivers/mfd/bcmbca_pmc3_pmb.c    | 1 +
 drivers/reset/reset-bcmbca-pmb.c | 1 +
 3 files changed, 3 insertions(+)

diff --git a/drivers/hwmon/bcm_pmb_pvtmon.c b/drivers/hwmon/bcm_pmb_pvtmon.c
index 3c58e0b..4fde15f 100644
--- a/drivers/hwmon/bcm_pmb_pvtmon.c
+++ b/drivers/hwmon/bcm_pmb_pvtmon.c
@@ -7,6 +7,7 @@
 #include <linux/clk.h>
 #include <linux/hwmon.h>
 #include <linux/mfd/bcmbca-pmb.h>
+#include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
diff --git a/drivers/mfd/bcmbca_pmc3_pmb.c b/drivers/mfd/bcmbca_pmc3_pmb.c
index 8607429..d268988 100644
--- a/drivers/mfd/bcmbca_pmc3_pmb.c
+++ b/drivers/mfd/bcmbca_pmc3_pmb.c
@@ -14,6 +14,7 @@
 #include <linux/log2.h>
 #include <linux/mfd/bcmbca-pmb.h>
 #include <linux/mfd/core.h>
+#include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/platform_device.h>
diff --git a/drivers/reset/reset-bcmbca-pmb.c b/drivers/reset/reset-bcmbca-pmb.c
index 80159b9..9dc5637 100644
--- a/drivers/reset/reset-bcmbca-pmb.c
+++ b/drivers/reset/reset-bcmbca-pmb.c
@@ -8,6 +8,7 @@
 #include <linux/cleanup.h>
 #include <linux/delay.h>
 #include <linux/mfd/bcmbca-pmb.h>
+#include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/platform_device.h>
